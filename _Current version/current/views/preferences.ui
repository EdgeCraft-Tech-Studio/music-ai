   <string notr="true">QDialog {
    background-color: #1A1A1A;
    color: #FFFFFF;
}

QLabel {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 400;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

QPushButton {
    background-color: #2C2C2E;
    border: 1px solid #3C3C3E;
    border-radius: 6px;
    color: #8E8E93;
    font-size: 13px;
    font-weight: 500;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    padding: 8px 12px;
    text-align: center;
}

QPushButton:hover {
    background-color: #3A3A3C;
    border-color: #4A4A4C;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #1C1C1E;
}

QPushButton#saveButton {
    background-color: #3478f6;
    border-color: #3478f6;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#saveButton:hover {
    background-color: #2a70d6;
    border-color: #2a70d6;
}

QPushButton#saveButton:pressed {
    background-color: #1f5bb5;
}

QLineEdit {
    background-color: #2C2C2E;
    border: 1px solid #48484A;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 400;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    padding: 8px 12px;
}

QLineEdit:focus {
    border: 2px solid #64B5F6;
    outline: none;
}

QLineEdit:read-only {
    background-color: #2C2C2E;
    color: #8E8E93;
}</string>
